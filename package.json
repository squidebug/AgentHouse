{
  "name": "agenthouse-workspace",
  "private": true,
  "description": "Local web console for running and observing AI coding-agent CLIs (Claude Code, Codex)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @agenthouse/web build && pnpm --filter @agenthouse/server build",
    "start": "node apps/server/dist/main.js --open",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "licenses:check": "node scripts/check-licenses.mjs",
    "spike:terminal": "pnpm --filter @agenthouse/spike-terminal-bridge start",
    "spike:terminal:smoke": "pnpm --filter @agenthouse/spike-terminal-bridge smoke"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ]
  }
}
