{
  "name": "agenthouse-workspace",
  "private": true,
  "description": "Local web console for running and observing AI coding-agent CLIs (Claude Code, Codex)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs stop",
    "build": "pnpm --filter @agenthouse/web build && pnpm --filter @agenthouse/server build",
    "start": "node apps/server/dist/main.js --open",
    "stop": "pnpm --filter @agenthouse/server exec tsx src/main.ts --stop",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "licenses:check": "node scripts/check-licenses.mjs",
    "canary:claude": "node scripts/canary-claude.mjs",
    "ui:check": "node scripts/ui-check.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
